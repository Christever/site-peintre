---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="L'entreprise - MS Peinture">
    <main>
        <!-- Introduction -->
        <section class="bg-[#1C1917] py-20 text-white">
            <div class="mx-auto max-w-4xl px-8 text-center">
                <p
                    class="text-sm font-semibold uppercase tracking-widest text-[#FDBA74]"
                >
                    L'entreprise
                </p>

                <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
                    MS Peinture
                </h1>

                <p
                    class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-[#D6D3D1]"
                >
                    Votre artisan peintre à Bédarieux et ses alentours,
                    au service de vos projets de rénovation et d'embellissement.
                </p>
            </div>
        </section>

        <!-- Présentation -->
        <section class="bg-[#FAFAF9] py-20">
            <div
                class="mx-auto grid max-w-6xl gap-12 px-8 lg:grid-cols-2 lg:items-center"
            >
                <div>
                    <p
                        class="text-sm font-semibold uppercase tracking-widest text-[#C2410C]"
                    >
                        Notre savoir-faire
                    </p>

                    <h2
                        class="mt-3 text-3xl font-bold tracking-tight text-[#1C1917]"
                    >
                        Un travail soigné, de la préparation aux finitions
                    </h2>

                    <p class="mt-6 leading-8 text-[#57534E]">
                        MS Peinture accompagne les particuliers dans leurs
                        projets de peinture et de rénovation. Chaque chantier
                        est réalisé avec attention, avec le souci du détail et
                        de la qualité des finitions.
                    </p>

                    <p class="mt-4 leading-8 text-[#57534E]">
                        Qu'il s'agisse de rafraîchir une pièce, de rénover des
                        volets ou un portail ou  de poser du papier peint, nous adaptons notre travail aux
                        besoins de chaque projet.
                    </p>
                </div>

                <div
                    class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-[#E7E5E4]"
                >
                    <h3 class="text-xl font-bold text-[#1C1917]">
                        Une approche de proximité
                    </h3>

                    <p class="mt-4 leading-7 text-[#57534E]">
                        Basée à Bédarieux, MS Peinture intervient dans les
                        communes environnantes pour proposer un service de
                        proximité et un accompagnement personnalisé.
                    </p>

                    <div class="mt-6 space-y-4">
                        <div class="flex gap-3">
                            <span class="text-xl text-[#C2410C]">✓</span>
                            <p class="text-[#57534E]">
                                Conseils adaptés à votre projet
                            </p>
                        </div>

                        <div class="flex gap-3">
                            <span class="text-xl text-[#C2410C]">✓</span>
                            <p class="text-[#57534E]">
                                Travail propre et soigné
                            </p>
                        </div>

                        <div class="flex gap-3">
                            <span class="text-xl text-[#C2410C]">✓</span>
                            <p class="text-[#57534E]">
                                Suivi du projet de A à Z
                            </p>
                        </div>

                        <div class="flex gap-3">
                            <span class="text-xl text-[#C2410C]">✓</span>
                            <p class="text-[#57534E]">
                                Intervention à Bédarieux et alentours
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Valeurs -->
        <section class="bg-white py-20">
            <div class="mx-auto max-w-6xl px-8">
                <div class="mx-auto max-w-2xl text-center">
                    <p
                        class="text-sm font-semibold uppercase tracking-widest text-[#C2410C]"
                    >
                        Nos engagements
                    </p>

                    <h2
                        class="mt-3 text-3xl font-bold tracking-tight text-[#1C1917]"
                    >
                        Ce qui compte pour nous
                    </h2>
                </div>

                <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    <article
                        class="rounded-2xl bg-[#FAFAF9] p-6 ring-1 ring-[#E7E5E4]"
                    >
                        <h3 class="text-xl font-bold text-[#1C1917]">
                            Qualité
                        </h3>

                        <p class="mt-3 leading-7 text-[#57534E]">
                            Une attention particulière portée à la préparation
                            des supports et aux finitions.
                        </p>
                    </article>

                    <article
                        class="rounded-2xl bg-[#FAFAF9] p-6 ring-1 ring-[#E7E5E4]"
                    >
                        <h3 class="text-xl font-bold text-[#1C1917]">
                            Écoute
                        </h3>

                        <p class="mt-3 leading-7 text-[#57534E]">
                            Des conseils et des solutions adaptés à vos envies
                            et aux contraintes de votre projet.
                        </p>
                    </article>

                    <article
                        class="rounded-2xl bg-[#FAFAF9] p-6 ring-1 ring-[#E7E5E4]"
                    >
                        <h3 class="text-xl font-bold text-[#1C1917]">
                            Proximité
                        </h3>

                        <p class="mt-3 leading-7 text-[#57534E]">
                            Une entreprise locale qui privilégie le contact
                            direct et un accompagnement personnalisé.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="bg-[#1C1917] py-16 text-white">
            <div class="mx-auto max-w-4xl px-8 text-center">
                <h2 class="text-3xl font-bold tracking-tight">
                    Parlons de votre projet
                </h2>

                <p class="mx-auto mt-4 max-w-2xl text-[#D6D3D1]">
                    Vous avez un projet de peinture ou de rénovation ?
                    Contactez-nous pour en discuter.
                </p>

                <a
                    href="/contact"
                    class="mt-8 inline-flex rounded-lg bg-[#C2410C] px-6 py-3 font-semibold text-white transition hover:bg-[#9A3412]"
                >
                    Demander un devis
                </a>
            </div>
        </section>
    </main>
</Layout>

