---
import Layout from "@/layouts/Layout.astro";
import { routes } from "@/routes/Routes";

import pp01 from "@/assets/images/realisations/papier_peint/pp01.webp";
import pp02 from "@/assets/images/realisations/papier_peint/pp02.webp";

import pi01 from "@/assets/images/realisations/peinture_interieure/pi01.webp";
import pi02 from "@/assets/images/realisations/peinture_interieure/pi02.webp";

import pe01 from "@/assets/images/realisations/peinture_exterieure/pe01.webp";
import pe02 from "@/assets/images/realisations/peinture_exterieure/pe02.webp";
---

<Layout
    title="Réalisations - MS Peinture"
    description="Découvrez des exemples de peinture intérieure, peinture extérieure accessible et pose de papier peint proposés par MS Peinture à Bédarieux et ses alentours."
>
    <main>
        <!-- Introduction -->
        <section class="bg-[#1C1917] py-20 text-white">
            <div class="mx-auto max-w-4xl px-8 text-center">
                <p
                    class="text-sm font-semibold uppercase tracking-widest text-[#FDBA74]"
                >
                    Nos réalisations
                </p>

                <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
                    Quelques exemples de travaux
                </h1>

                <p
                    class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-[#D6D3D1]"
                >
                    Découvrez à travers ces images les différents types de
                    travaux proposés par MS Peinture à Bédarieux et ses
                    alentours.
                </p>

                <p
                    class="mx-auto mt-4 max-w-2xl text-sm leading-6 text-[#A8A29E]"
                >
                    Les images présentées sont illustratives et ne correspondent
                    pas nécessairement à des réalisations de MS Peinture.
                </p>
            </div>
        </section>

                <!-- Peinture intérieure -->
        <section class="bg-[#FAFAF9] py-20">
            <div class="mx-auto max-w-6xl px-8">
                <div class="mb-10">
                    <p
                        class="text-sm font-semibold uppercase tracking-widest text-[#C2410C]"
                    >
                        Peinture intérieure
                    </p>

                    <h2 class="mt-2 text-3xl font-bold tracking-tight text-[#1C1917]">
                        Des intérieurs soignés et personnalisés
                    </h2>

                    <p class="mt-4 max-w-2xl leading-7 text-[#57534E]">
                        Peinture des murs, plafonds et boiseries, avec une
                        attention particulière portée à la préparation des
                        supports et aux finitions.
                    </p>
                </div>

                <div class="grid gap-6 md:grid-cols-2">
                    <figure class="group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-[#E7E5E4]">
                        <img
                            src={pi01.src}
                            alt="Exemple de peinture intérieure"
                            class="h-80 w-full object-cover transition duration-500 group-hover:scale-105"
                        />
                    </figure>

                    <figure class="group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-[#E7E5E4]">
                        <img
                            src={pi02.src}
                            alt="Exemple de peinture intérieure"
                            class="h-80 w-full object-cover transition duration-500 group-hover:scale-105"
                        />
                    </figure>
                </div>
            </div>
        </section>

                <!-- Peinture extérieure -->
        <section class="bg-white py-20">
            <div class="mx-auto max-w-6xl px-8">
                <div class="mb-10">
                    <p
                        class="text-sm font-semibold uppercase tracking-widest text-[#C2410C]"
                    >
                        Peinture extérieure
                    </p>

                    <h2
                        class="mt-2 text-3xl font-bold tracking-tight text-[#1C1917]"
                    >
                        Redonner vie à vos extérieurs
                    </h2>

                    <p class="mt-4 max-w-2xl leading-7 text-[#57534E]">
                        Nous intervenons notamment sur les éléments extérieurs
                        accessibles comme les volets et les portails, sans
                        nécessiter d'échafaudage ou de matériel spécifique.
                    </p>
                </div>

                <div class="grid gap-6 md:grid-cols-2">
                    <figure
                        class="group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-[#E7E5E4]"
                    >
                        <img
                            src={pe01.src}
                            alt="Exemple de peinture extérieure"
                            class="h-80 w-full object-cover transition duration-500 group-hover:scale-105"
                        />
                    </figure>

                    <figure
                        class="group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-[#E7E5E4]"
                    >
                        <img
                            src={pe02.src}
                            alt="Exemple de peinture extérieure"
                            class="h-80 w-full object-cover transition duration-500 group-hover:scale-105"
                        />
                    </figure>
                </div>
            </div>
        </section>

                <!-- Papier peint -->
        <section class="bg-[#FAFAF9] py-20">
            <div class="mx-auto max-w-6xl px-8">
                <div class="mb-10">
                    <p
                        class="text-sm font-semibold uppercase tracking-widest text-[#C2410C]"
                    >
                        Papier peint
                    </p>

                    <h2
                        class="mt-2 text-3xl font-bold tracking-tight text-[#1C1917]"
                    >
                        Donner du caractère à vos murs
                    </h2>

                    <p class="mt-4 max-w-2xl leading-7 text-[#57534E]">
                        Préparation des supports et pose soignée pour mettre en
                        valeur vos murs et vos motifs, avec une attention
                        particulière portée aux raccords et aux finitions.
                    </p>
                </div>

                <div class="grid gap-6 md:grid-cols-2">
                    <figure
                        class="group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-[#E7E5E4]"
                    >
                        <img
                            src={pp01.src}
                            alt="Exemple de pose de papier peint"
                            class="h-80 w-full object-cover transition duration-500 group-hover:scale-105"
                        />
                    </figure>

                    <figure
                        class="group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-[#E7E5E4]"
                    >
                        <img
                            src={pp02.src}
                            alt="Exemple de pose de papier peint"
                            class="h-80 w-full object-cover transition duration-500 group-hover:scale-105"
                        />
                    </figure>
                </div>
            </div>
        </section>

                <!-- CTA -->
        <section class="bg-[#1C1917] py-16 text-white">
            <div class="mx-auto max-w-4xl px-8 text-center">
                <h2 class="text-3xl font-bold tracking-tight">
                    Un projet en tête ?
                </h2>

                <p class="mx-auto mt-4 max-w-2xl text-[#D6D3D1]">
                    Peinture intérieure, extérieure ou pose de papier peint :
                    échangeons sur votre projet.
                </p>

                <a
                    href={routes.contact}
                    class="mt-8 inline-flex rounded-lg bg-[#C2410C] px-6 py-3 font-semibold text-white transition hover:bg-[#9A3412]"
                >
                    Demander un devis
                </a>
            </div>
        </section>

    </main>
</Layout>