---
import "@/styles/global.css"
const { title = "Artisan peintre" } = Astro.props;

import Header  from "@/components/Header.astro"
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <meta
            name="description"
            content="Artisan peintre - Peinture intérieure, extérieure et rénovation."
        />

        <title>{title}</title>
    </head>

    <body class="min-h-screen bg-slate-50 text-slate-900">
        <Header/>
        <slot />
    </body>
</html>