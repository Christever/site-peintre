---
import Layout from "@/layouts/Layout.astro";
import { routes } from "@/routes/Routes";
---

<Layout
    title="Page introuvable - MS Peinture"
    description="La page demandée est introuvable."
>
    <main class="flex min-h-[70vh] items-center justify-center bg-[#FAFAF9]">
        <section class="px-8 py-20 text-center">
            <p
                class="text-sm font-semibold uppercase tracking-widest text-[#C2410C]"
            >
                Oups...
            </p>

            <h1
                class="mt-4 text-7xl font-bold tracking-tight text-[#1C1917] sm:text-8xl"
            >
                404
            </h1>

            <h2
                class="mt-6 text-2xl font-bold text-[#1C1917] sm:text-3xl"
            >
                Page introuvable
            </h2>

            <p
                class="mx-auto mt-4 max-w-lg text-lg leading-8 text-[#57534E]"
            >
                La page que vous recherchez n'existe pas ou a peut-être été
                déplacée.
            </p>

            <div class="mt-8 flex flex-wrap justify-center gap-4">
                <a
                    href={routes.accueil}
                    class="rounded-lg bg-[#C2410C] px-6 py-3 font-semibold text-white transition hover:bg-[#9A3412]"
                >
                    Retour à l'accueil
                </a>

                <a
                    href={routes.contact}
                    class="rounded-lg border border-[#D6D3D1] px-6 py-3 font-semibold text-[#292524] transition hover:bg-white"
                >
                    Nous contacter
                </a>
            </div>
        </section>
    </main>
</Layout>

