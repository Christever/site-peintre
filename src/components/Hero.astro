---
import { routes } from "@/routes/Routes";
---

<section class="bg-[#1C1917] text-white">
  <div class="mx-auto max-w-7xl px-8">
    <div class="py-24 lg:py-32">
      <div class="max-w-3xl">
        <p
          class="mb-4 text-sm font-semibold uppercase tracking-widest text-[#D6D3D1]"
        >
          Bédarieux & alentours
        </p>

        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
          MS Peinture
        </h1>

        <p class="mt-6 text-xl leading-8 text-[#E7E5E4]">
          Votre artisan peintre à Bédarieux et ses alentours.
        </p>

        <p class="mt-4 max-w-2xl text-lg leading-8 text-[#A8A29E]">
          Peinture intérieure et extérieure, pose de papier peint et revêtements
          de sol pour vos projets de rénovation.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href={routes.contact}
            class="rounded-lg bg-[#C2410C] px-6 py-3 font-semibold text-white shadow-sm transition hover:bg-[#9A3412]"
          >
            Demander un devis
          </a>

          <a
            href={routes.prestations}
            class="rounded-lg border border-[#57534E] px-6 py-3 font-semibold text-white transition hover:bg-[#292524]"
          >
            Découvrir nos prestations
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
