---
import Layout from "@/layouts/Layout.astro";

const title = "Mentions légales - MS Peinture";
const description =
    "Mentions légales du site MS Peinture, artisan peintre à Bédarieux et ses alentours.";
---

<Layout title={title} description={description}>
    <main class="bg-stone-50">
        <section class="mx-auto max-w-4xl px-6 py-16 md:py-20">
            <div class="mb-12">
                <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-orange-700">
                    Informations légales
                </p>

                <h1 class="text-3xl font-bold tracking-tight text-stone-900 md:text-4xl">
                    Mentions légales
                </h1>

                <p class="mt-4 text-stone-600">
                    Informations relatives à l'éditeur et à l'hébergement du site
                    MS Peinture.
                </p>
            </div>

            <div class="space-y-10 text-stone-700">
                <!-- Éditeur -->
                <section>
                    <h2 class="mb-4 text-xl font-semibold text-stone-900">
                        Éditeur du site
                    </h2>

                    <div class="space-y-2">
                        <p>
                            <strong>MS PEINTURE</strong>
                        </p>
                        <p>
                            STEVERLYNCK Mickael
                        </p>
                        <p>
                            Entrepreneur individuel (EI) – régime micro-entrepreneur
                        </p>
                        <p>
                            7 avenue Abbé Tarroux<br />
                            34600 Bédarieux<br />
                            France
                        </p>
                        <p>
                            <strong>SIRET : </strong> 941 755 894 00016
                        </p>
                        <p>
                            <strong>Téléphone : </strong>
                            <a
                                href="tel:+33787982071"
                                class="text-orange-700 hover:underline"
                            >
                                07 87 98 20 71
                            </a>
                        </p>
                        <p>
                            <strong>Email : </strong>
                            <a
                                href="mailto:mspeinture-contact@steverlynck.fr"
                                class="text-orange-700 hover:underline"
                            >
                                mspeinture-contact@steverlynck.fr
                            </a>
                        </p>
                    </div>
                </section>

                <!-- Activité -->
                <section>
                    <h2 class="mb-4 text-xl font-semibold text-stone-900">
                        Activité
                    </h2>

                    <p class="mb-3">
                        MS Peinture propose des prestations de :
                    </p>

                    <ul class="list-disc space-y-1 pl-6">
                        <li>peinture intérieure ;</li>
                        <li>peinture extérieure accessible ;</li>
                        <li>pose de papier peint.</li>
                    </ul>

                    <p class="mt-4">
                        Les prestations sont principalement destinées aux particuliers
                        à Bédarieux et dans les communes environnantes.
                    </p>
                </section>

                <!-- TVA -->
                <section>
                    <h2 class="mb-4 text-xl font-semibold text-stone-900">
                        TVA
                    </h2>

                    <p>
                        TVA non applicable, art. 293 B du Code général des impôts.
                    </p>
                </section>

                <!-- Directeur de publication -->
                <section>
                    <h2 class="mb-4 text-xl font-semibold text-stone-900">
                        Directeur de la publication
                    </h2>

                    <p>
                        STEVERLYNCK Mickael
                    </p>
                </section>

                <!-- Hébergement -->
                <section>
                    <h2 class="mb-4 text-xl font-semibold text-stone-900">
                        Hébergement
                    </h2>

                    <div class="space-y-2">
                        <p>
                            <strong>Groupe CELESTE – Nuxit</strong>
                        </p>
                        <p>
                            20 rue Albert Einstein<br />
                            77420 Champs-sur-Marne<br />
                            France
                        </p>
                        <p>
                            Site : 
                            <a
                                href="https://www.nuxit.com/"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-orange-700 hover:underline"
                            >
                                www.nuxit.com
                            </a>
                        </p>
                    </div>
                </section>


                <!-- Médiation -->
                <section>
                    <h2 class="mb-4 text-xl font-semibold text-stone-900">
                        Médiation de la consommation
                    </h2>

                    <p class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-amber-900">
                        Les coordonnées du médiateur de la consommation dont relève
                        MS Peinture seront indiquées sur cette page dès que le médiateur
                        aura été désigné.
                    </p>
                </section>

                <!-- Responsabilité -->
                <section>
                    <h2 class="mb-4 text-xl font-semibold text-stone-900">
                        Responsabilité
                    </h2>

                    <p>
                        Les informations présentées sur ce site sont fournies à titre
                        informatif. MS Peinture s'efforce de maintenir les informations
                        publiées à jour, sans garantir qu'elles soient exemptes
                        d'erreurs ou d'omissions.
                    </p>

                    <p class="mt-4">
                        Les photographies et contenus présents sur le site sont
                        protégés par les dispositions applicables en matière de
                        propriété intellectuelle. Toute reproduction ou utilisation
                        non autorisée est interdite.
                    </p>
                </section>

                <!-- Mise à jour -->
                <section>
                    <h2 class="mb-4 text-xl font-semibold text-stone-900">
                        Mise à jour des mentions légales
                    </h2>

                    <p>
                        Les présentes mentions légales peuvent être modifiées à tout
                        moment afin de tenir compte des évolutions de l'activité,
                        du site ou de la réglementation applicable.
                    </p>
                </section>
            </div>
        </section>
    </main>
</Layout>

