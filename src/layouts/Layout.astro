---
import "@/styles/global.css"
const {
    title = "MS Peinture - Artisan peintre à Bédarieux",
    description = "MS Peinture, artisan peintre à Bédarieux et ses alentours. Peinture intérieure, peinture extérieure accessible et pose de papier peint.",
    noindex=false,
} = Astro.props;

import Header  from "@/components/Header.astro"
import Footer from "@/components/Footer.astro"
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />

        <link rel="icon" type="image/png" href="/mspeinture/favicon.png" />
        <link rel="apple-touch-icon" href="/mspeinture/apple-touch-icon.png" />
        
        <meta name="viewport" content="width=device-width" />

        <meta name="description" content={description} />

        {noindex && <meta name="robots" content="noindex, nofollow" />}

        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:image" content={`${Astro.site}og-image.webp`} />
        <meta property="og:locale" content="fr_FR" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={`${Astro.site}og-image.webp`} />

        <title>{title}</title>
    </head>

    <body class="min-h-screen bg-slate-50 text-slate-900">
        <Header/>
        <slot />
        <Footer/>
    </body>
</html>