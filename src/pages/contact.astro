---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Contact - MS Peinture">
    <main>
        <!-- Introduction -->
        <section class="bg-[#1C1917] py-20 text-white">
            <div class="mx-auto max-w-4xl px-8 text-center">
                <p
                    class="text-sm font-semibold uppercase tracking-widest text-[#FDBA74]"
                >
                    Contact
                </p>

                <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
                    Parlons de votre projet
                </h1>

                <p
                    class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-[#D6D3D1]"
                >
                    Une question, un projet de peinture ou de pose de papier
                    peint ? Contactez MS Peinture à Bédarieux et ses alentours.
                </p>
            </div>
        </section>
                <!-- Contact -->
        <section class="bg-[#FAFAF9] py-20">
            <div class="mx-auto max-w-6xl px-8">
                <div class="grid gap-12 lg:grid-cols-2">

                    <!-- Coordonnées -->
                    <div>
                        <p
                            class="text-sm font-semibold uppercase tracking-widest text-[#C2410C]"
                        >
                            Nous contacter
                        </p>

                        <h2
                            class="mt-2 text-3xl font-bold tracking-tight text-[#1C1917]"
                        >
                            Échangeons sur votre projet
                        </h2>

                        <p class="mt-5 leading-7 text-[#57534E]">
                            Vous souhaitez obtenir un renseignement ou
                            échanger sur un projet de peinture ou de papier
                            peint ? N'hésitez pas à nous contacter.
                        </p>

                        <div class="mt-8 space-y-6">

                            <!-- Téléphone -->
                            <div class="flex gap-4">
                                <div
                                    class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#FFF7ED] text-xl text-[#C2410C]"
                                >
                                    ☎
                                </div>

                                <div>
                                    <h3 class="font-semibold text-[#1C1917]">
                                        Téléphone
                                    </h3>

                                    <p class="mt-1 text-[#57534E]">
                                        Votre numéro de téléphone
                                    </p>
                                </div>
                            </div>

                            <!-- Email -->
                            <div class="flex gap-4">
                                <div
                                    class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#FFF7ED] text-xl text-[#C2410C]"
                                >
                                    ✉
                                </div>

                                <div>
                                    <h3 class="font-semibold text-[#1C1917]">
                                        Email
                                    </h3>

                                    <a
                                        href="mailto:mspeinture-contact@steverlynck.fr"
                                        class="text-[#57534E] transition hover:text-[#C2410C]"
                                    >
                                        mspeinture-contact@steverlynck.fr
                                    </a>
                                </div>
                            </div>

                            <!-- Zone -->
                            <div class="flex gap-4">
                                <div
                                    class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#FFF7ED] text-xl text-[#C2410C]"
                                >
                                    📍
                                </div>

                                <div>
                                    <h3 class="font-semibold text-[#1C1917]">
                                        Zone d'intervention
                                    </h3>

                                    <p class="mt-1 text-[#57534E]">
                                        Bédarieux et ses alentours
                                    </p>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Formulaire -->
                    <div
                        class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-[#E7E5E4] lg:p-10"
                    >
                        <h2 class="text-2xl font-bold text-[#1C1917]">
                            Demander un devis
                        </h2>

                        <p class="mt-2 text-sm leading-6 text-[#57534E]">
                            Décrivez-nous votre projet et nous vous
                            recontacterons.
                        </p>

                        <form class="mt-8 space-y-5">

                            <!-- Nom / Prénom -->
                            <div class="grid gap-6 sm:grid-cols-2">
                                <div>
                                    <label
                                        for="nom"
                                        class="block text-sm font-medium text-[#292524]"
                                    >
                                        Nom
                                    </label>

                                    <input
                                        id="nom"
                                        name="nom"
                                        type="text"
                                        autocomplete="family-name"
                                        required
                                        class="mt-2 w-full rounded-lg border border-[#D6D3D1] bg-white px-4 py-3 outline-none transition focus:border-[#C2410C] focus:ring-2 focus:ring-[#C2410C]/20"
                                    />
                                </div>

                                <div>
                                    <label
                                        for="prenom"
                                        class="block text-sm font-medium text-[#292524]"
                                    >
                                        Prénom
                                    </label>

                                    <input
                                        id="prenom"
                                        name="prenom"
                                        type="text"
                                        autocomplete="given-name"
                                        required
                                        class="mt-2 w-full rounded-lg border border-[#D6D3D1] bg-white px-4 py-3 outline-none transition focus:border-[#C2410C] focus:ring-2 focus:ring-[#C2410C]/20"
                                    />
                                </div>
                            </div>

                            <!-- Email -->
                            <div>
                                <label
                                    for="email"
                                    class="block text-sm font-medium text-[#292524]"
                                >
                                    Email
                                </label>

                                <input
                                    id="email"
                                    name="email"
                                    type="email"
                                    autocomplete="email"
                                    required
                                    class="mt-2 w-full rounded-lg border border-[#D6D3D1] bg-white px-4 py-3 outline-none transition focus:border-[#C2410C] focus:ring-2 focus:ring-[#C2410C]/20"
                                />
                            </div>

                            <!-- Téléphone -->
                            <div>
                                <label
                                    for="telephone"
                                    class="block text-sm font-medium text-[#292524]"
                                >
                                    Téléphone
                                </label>

                                <input
                                    id="telephone"
                                    name="telephone"
                                    type="tel"
                                    autocomplete="tel"
                                    class="mt-2 w-full rounded-lg border border-[#D6D3D1] bg-white px-4 py-3 outline-none transition focus:border-[#C2410C] focus:ring-2 focus:ring-[#C2410C]/20"
                                />
                            </div>

                            <!-- Message -->
                            <div>
                                <label
                                    for="message"
                                    class="block text-sm font-medium text-[#292524]"
                                >
                                    Votre message
                                </label>

                                <textarea
                                    id="message"
                                    name="message"
                                    rows="6"
                                    required
                                    class="mt-2 w-full resize-y rounded-lg border border-[#D6D3D1] bg-white px-4 py-3 outline-none transition focus:border-[#C2410C] focus:ring-2 focus:ring-[#C2410C]/20"
                                ></textarea>
                            </div>

                            <!-- Bouton -->
                            <button
                                type="submit"
                                class="w-full rounded-lg bg-[#C2410C] px-6 py-3 font-semibold text-white transition hover:bg-[#9A3412]"
                            >
                                Envoyer ma demande
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

