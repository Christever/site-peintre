---
import { routes } from "@/routes/Routes";
import  {constants}  from "@/utils/constants";
---
<footer class=" mt-8 border-t border-[#44403C] bg-[#0F0E0D] text-[#D6D3D1]">
    <div class="mx-auto max-w-7xl px-8 py-12">
        <div class="grid gap-10 md:grid-cols-3">
            <div>
                <h2 class="text-xl font-bold text-white">
                    MS Peinture
                </h2>

                <p class="mt-3 max-w-sm leading-7 text-[#A8A29E]">
                    {constants.title}
                    {constants.ville}
                    {constants.description}
                </p>
            </div>

            <div>
                <h3 class="font-semibold text-white">
                    Navigation
                </h3>

                <ul class="mt-4 space-y-2">
                    <li>
                        <a
                            href={routes.accueil}
                            class="transition hover:text-[#FB923C]"
                        >
                            Accueil
                        </a>
                    </li>

                    <li>
                        <a
                            href={routes.entreprise}
                            class="transition hover:text-[#FB923C]"
                        >
                            L'entreprise
                        </a>
                    </li>

                    <li>
                        <a
                            href={routes.prestations}
                            class="transition hover:text-[#FB923C]"
                        >
                            Prestations
                        </a>
                    </li>

                    <li>
                        <a
                            href={routes.realisations}
                            class="transition hover:text-[#FB923C]"
                        >
                            Réalisations
                        </a>
                    </li>

                    <li>
                        <a
                            href={routes.contact}
                            class="transition hover:text-[#FB923C]"
                        >
                            Contact
                        </a>
                    </li>
                </ul>
            </div>

            <div>
                <h3 class="font-semibold text-white">
                    Nous trouver
                </h3>

                <p class="mt-4 leading-7">
                    Bédarieux<br />
                    34600 et alentours
                </p>

                <a
                    href={routes.contact}
                    class="mt-4 inline-block font-semibold text-[#FB923C] transition hover:text-[#FDBA74]"
                >
                    Nous contacter →
                </a>
            </div>
        </div>

        <div
            class="mt-10 border-t border-[#44403C] pt-6 text-sm text-[#78716C]"
        >
            <p>
                © {new Date().getFullYear()} MS Peinture. Tous droits réservés.
            </p>
        </div>
    </div>
</footer>

